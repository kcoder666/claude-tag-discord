# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
# Register slash commands in one server instantly while developing (otherwise global, ~1h to appear).
DEV_GUILD_ID=
# Discord user ids treated as owners (admin everywhere), comma-separated.
OWNER_IDS=
# Set to "false" if you don't enable the privileged Server Members intent (guest/role checks get less reliable).
GUILD_MEMBERS_INTENT=true

# ── Claude credential (pick one; first one set wins unless AUTH_MODE forces it) ──
# 1) Anthropic API key (recommended for anything shared). Billed per token.
ANTHROPIC_API_KEY=
# 2) Your own Claude Pro/Max subscription: run `claude setup-token` and paste the token.
#    Only your own token, for your own self-hosted bot. Read README → Authentication first.
CLAUDE_CODE_OAUTH_TOKEN=
# 3) Neither set: uses whatever `claude /login` account is logged in on this machine.
# AUTH_MODE=api-key|subscription|local-login

# ── Security ──────────────────────────────────────────────────────────────────
# Encrypts connection secrets and personal API keys at rest. Any long random string. Don't lose it.
SECRET_KEY=
# Sandbox shell commands (filesystem + network allowlist + credential masking). Strongly recommended.
SANDBOX_ENABLED=true
# default = our policy + Approve/Deny buttons; auto = Claude Code's auto-mode classifier.
PERMISSION_MODE=default
APPROVAL_TIMEOUT_MINUTES=15

# ── Models ────────────────────────────────────────────────────────────────────
DEFAULT_MODEL=claude-opus-5
ALLOWED_MODELS=claude-opus-5,claude-sonnet-5,claude-haiku-4-5
# The always-on channel session (triage + short replies) and its effort.
CHANNEL_MODEL=claude-opus-5
CHANNEL_EFFORT=low
TASK_EFFORT=high

# ── Behaviour ─────────────────────────────────────────────────────────────────
DEFAULT_RESPOND_AUTOMATICALLY=true
DEFAULT_TIMEZONE=UTC
ALLOW_DMS=true
DM_FALLBACK_TO_BOT_CREDENTIAL=true
SANDBOX_IDLE_MINUTES=5
CHANNEL_SESSION_IDLE_MINUTES=60
CHANNEL_SESSION_MAX_AGE_HOURS=24
STOP_READING_AFTER=100
THREAD_CONTEXT_WINDOW=50
MAX_TURNS_PER_MESSAGE=200
# Spend limits compare against the SDK's estimated list-price cost. Consider false on a subscription.
ENFORCE_SPEND_LIMITS=true

# ── Optional ──────────────────────────────────────────────────────────────────
DATA_DIR=./data
# Hosted pages: set a public URL that reaches HTTP_PORT (e.g. behind a reverse proxy).
PUBLIC_BASE_URL=
HTTP_PORT=8787
# Used only by the bot (never passed to Claude) to poll pull requests for PR subscriptions.
GITHUB_TOKEN=
PR_POLL_SECONDS=120
FEEDBACK_CHANNEL_ID=
LOG_LEVEL=info
